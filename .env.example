NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: screening cache, cron jobs, account deletion. Never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# SEC EDGAR requires a descriptive User-Agent with a contact email.
SEC_USER_AGENT="Halisia contact@votre-domaine.fr"
# Optional, only used by the FMP provider. Keep it server-side (no NEXT_PUBLIC_ prefix).
FMP_API_KEY=

# Emails (Resend). RESEND_FROM must use a domain verified in Resend, e.g. "Halisia <alertes@votre-domaine.fr>".
RESEND_API_KEY=
RESEND_FROM=

# Shared secret for /api/send-daily-summary and /api/process-notifications.
# On Vercel, crons defined in vercel.json send it automatically.
CRON_SECRET=
NEXT_PUBLIC_APP_URL=

# Set to "true" once the Google provider is configured in Supabase (Authentication → Providers).
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=
